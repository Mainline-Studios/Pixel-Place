# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token Expiration (default: 7d)
JWT_EXPIRES_IN=7d

# Database Path (optional, defaults to data/database.db)
DATABASE_PATH=data/database.db

# Node Environment
NODE_ENV=development

# Stripe (required for Pixel Coins purchases)
# Get keys from https://dashboard.stripe.com/apikeys
# Test mode: pk_test_... and sk_test_...
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret from Stripe Dashboard > Developers > Webhooks
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhook` and use printed whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Base URL for Stripe redirects (production: https://your-domain.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API base URL for static export (Firebase Cloud Functions)
# When hosting static Next.js elsewhere, set this to your Cloud Functions URL, e.g.:
# https://us-central1-pixel-place-823b1.cloudfunctions.net
# Leave empty to use same-origin (Next.js API routes during local dev)
NEXT_PUBLIC_API_URL=
