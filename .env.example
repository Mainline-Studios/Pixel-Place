# JWT Secret - REQUIRED IN PRODUCTION. Do not use default; auth will fail.
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token Expiration (default: 7d)
JWT_EXPIRES_IN=7d

# Admin accounts (server-only). Option A: JSON array (multiple admins)
ADMIN_ACCOUNTS_JSON=[{"username":"admin","password":"change-me"}]
# Option B (production-friendly): single admin — set both and admin login works without JSON
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password
# Optional: comma-separated head admin usernames (default: admin)
# HEAD_ADMIN_USERNAMES=admin
# Dev: if neither set, admin/admin is used. Production: set one of the options above.
# Firebase: .env is not deployed. Set ADMIN_* in Console (Functions → env) OR create Firestore doc config/admin with fields admin_username, admin_password.

# One-off / dev-only Next API routes: POST /api/admin/reset-password, initialize-accounts, cleanup-old-admins
# Require header x-admin-setup-secret matching this value (never commit the real value).
# ADMIN_SETUP_SECRET=openssl-rand-hex-32

# Database Path (optional, defaults to data/database.db)
DATABASE_PATH=data/database.db

# Node Environment
NODE_ENV=development

# Stripe (Pixel Coins / Pixel Place Pay)
# Get keys from https://dashboard.stripe.com/apikeys
# Production: set STRIPE_SECRET_KEY + STRIPE_PUBLISHABLE_KEY in functions/.env (publishable is served via /api/pixel-pay/stripe-publishable-key).
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Optional local Next: skip the publishable-key fetch if set
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret from Stripe Dashboard > Developers > Webhooks
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhook` and use printed whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Base URL for Stripe redirects (production: https://your-domain.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API base URL for static export (Firebase Cloud Functions)
# Production: set to Cloud Functions URL (no trailing slash), e.g.:
# NEXT_PUBLIC_API_URL=https://us-central1-pixel-place-823b1.cloudfunctions.net
# Local dev: leave empty to use Next.js API routes (npm run dev)
NEXT_PUBLIC_API_URL=

# PPAF (.ppaf) — optional: override embedded public key in lib/ppafEmbeddedPublicKey.ts after key rotation
# NEXT_PUBLIC_PPAF_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Public status page URL (footer / login link). Default in code: https://status.pixelplaceofficial.com
# NEXT_PUBLIC_STATUS_PAGE_URL=https://status.pixelplaceofficial.com

# Firebase Web SDK (required for client Realtime Database sync, Chess online, etc.)
# Firebase Console → Project settings → Your apps → Web app → copy config. Never commit real values.
# Must be present at `npm run build` for static export (Firebase Hosting / CI).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics:
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Release notes API (Settings → Release notes; GitHub folder only)
# Defaults: Mainline-Studios/Pixel-Place @ main · "Latest Update Logs"
# UPDATE_LOGS_GITHUB_OWNER=Mainline-Studios
# UPDATE_LOGS_GITHUB_REPO=Pixel-Place
# UPDATE_LOGS_GITHUB_REF=main
# UPDATE_LOGS_GITHUB_PATH=Latest Update Logs
# Optional token for higher GitHub API rate limits (public repo works without):
# GITHUB_TOKEN=

# Pyx content filter (server + optional client)
PYX_SERVICE_URL=https://pyxaiapi-574247481583.us-central1.run.app
# Optional: for client-side pyx-client.js (baseUrl + apiKey)
# NEXT_PUBLIC_PYX_SERVICE_URL=https://pyxaiapi-574247481583.us-central1.run.app
# NEXT_PUBLIC_PYX_API_KEY=your-pyx-key

# Anthropic Claude (game generation, Pyx moderation, Eco Hero AI citizens)
# Get key from https://console.anthropic.com/
# Production: set in Firebase (Functions env) or Google Cloud Secret Manager / Vercel / Railway.
ANTHROPIC_API_KEY=
