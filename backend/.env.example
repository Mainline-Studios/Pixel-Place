# PostgreSQL (Docker Compose matches these defaults)
DATABASE_URL=postgresql://pixelplace:pixelplace@localhost:5432/pixelplace

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# OAuth — Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/

# Apple Sign-In — verify token server-side (optional)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
SOCKET_PATH=/socket.io

# Legal & compliance (version strings should match in-app / policy pages)
LEGAL_TERMS_VERSION=2026-04-22
LEGAL_PRIVACY_VERSION=2026-04-22
# Optional: 32-byte key, base64 — for AES-256-GCM (lib/cryptoAtRest), e.g. export artifacts
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=
# When a user deletes their account, factions they created transfer ownership to this user ID (otherwise first admin)
# ACCOUNT_TRANSFER_USER_ID=

# Scale-out (optional — omit REDIS_URL for single-process dev)
# Same URL is used for: Socket.IO Redis adapter, HTTP response cache, BullMQ.
REDIS_URL=
# Leaderboard REST cache TTL (seconds) when Redis is set
LEADERBOARD_CACHE_TTL_SEC=5
# Territory socket batching (ms window, max cells before flush)
TERRITORY_BATCH_MS=55
TERRITORY_BATCH_MAX=120
# Debounce leaderboard Socket pushes after territory/pixel scoring (ms)
LEADERBOARD_EMIT_DEBOUNCE_MS=220

# Stripe (optional — omit STRIPE_SECRET_KEY to disable billing routes)
# Webhook URL: POST {API}/api/v1/billing/webhook (raw body; set secret in Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_COSMETIC_THEMES=
STRIPE_PRICE_COOLDOWN_BOOST=
STRIPE_PRICE_PRIVATE_CANVAS_SLOT=
# Return URL for Checkout / Customer Portal (e.g. http://localhost:3000)
BILLING_FRONTEND_BASE_URL=http://localhost:3000

# Abuse / bot prevention (optional)
# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
# Frontend: NEXT_PUBLIC_TURNSTILE_SITE_KEY (same dashboard)
ABUSE_CHECKS_DISABLED=false
