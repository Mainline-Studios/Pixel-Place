{
  "name": "pixel-place-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server-integrated.js",
    "dev:next": "next dev -p 3000",
    "server": "node server.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
