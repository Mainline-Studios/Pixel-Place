# Copy this file to .env and add your keys.
# IMPORTANT: Every deploy pushes THIS .env to the cloud. Console env vars are OVERWRITTEN.
# So put JWT_SECRET and all secrets HERE — that's the only place that sticks after deploy.
# See ENV_README.md in this folder.

# JWT Secret - REQUIRED in production. Put your real secret below (do not commit .env).
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# PPAF (.ppaf signed account backups). PEM PKCS#8 private key — NEVER expose to clients.
# Generate keypair: from repo root run `node scripts/generate-ppaf-keys.mjs` then paste JSON output.
# PPAF_ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Admin: ADMIN_ACCOUNTS_JSON and/or ADMIN_USERNAME + ADMIN_PASSWORD (production: set in Firebase env)
# ADMIN_ACCOUNTS_JSON=[{"username":"admin","password":"change-me"}]
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Next.js only (npm run dev): secret header for /api/admin/* and cleanup routes — see docs/SECURITY_REVIEW_2026.md
# ADMIN_SETUP_SECRET=

AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here

# Pyx (same base URL as public/pyx-client.js; optional key if your Pyx API requires it)
PYX_SERVICE_URL=https://pyxaiapi-574247481583.us-central1.run.app
# PYX_API_KEY=your-pyx-api-key-if-required

# Claude: game generation + Pyx moderation backup (optional)
# Add your key here, then:  npm run build  &&  firebase deploy --only functions
ANTHROPIC_API_KEY=

# Optional: other features that call OpenAI from the server (HistoriMac Computer Use is BYOK in the app).
OPENAI_API_KEY=

# In-app payments (Stripe Payment Element + PaymentIntents; webhook credits coins)
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_live_... or pk_test_...  (served to the app via GET /api/pixel-pay/stripe-publishable-key — no frontend build secret)
# STRIPE_WEBHOOK_SECRET=whsec_...  (Stripe Dashboard → webhook → signing secret for payment_intent.succeeded)
# Webhook URL: same host as functions, path /api/webhook (raw body required — mounted before express.json).
# Optional local Next dev only: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  (skips the publishable-key fetch)
# APP_PUBLIC_URL=https://pixelplaceofficial.com
