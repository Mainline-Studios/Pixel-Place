# Copy this file to .env and add your keys. Required for AI game generation.
# Both local/emulator and production load this file (no deprecated config, no Console).

# JWT Secret - REQUIRED in production. Auth fails if missing or default.
# Set in Firebase: firebase functions:config:set jwt.secret="$(openssl rand -base64 32)"
# Or use .env: JWT_SECRET=your-secret (do not commit).
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin accounts JSON (same format as Next.js). Set via Firebase config or .env.
# ADMIN_ACCOUNTS_JSON=[{"username":"admin","password":"change-me"}]

AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here

# Pyx content filter
PYX_SERVICE_URL=https://pyxaiapi-574247481583.us-central1.run.app

# Claude: game generation + Pyx moderation backup (optional)
# Add your key here, then:  npm run build  &&  firebase deploy --only functions
ANTHROPIC_API_KEY=
