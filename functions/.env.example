# Copy this file to .env and add your keys.
# IMPORTANT: Every deploy pushes THIS .env to the cloud. Console env vars are OVERWRITTEN.
# So put JWT_SECRET and all secrets HERE — that's the only place that sticks after deploy.
# See ENV_README.md in this folder.

# JWT Secret - REQUIRED in production. Put your real secret below (do not commit .env).
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin: ADMIN_ACCOUNTS_JSON and/or ADMIN_USERNAME + ADMIN_PASSWORD (production: set in Firebase env)
# ADMIN_ACCOUNTS_JSON=[{"username":"admin","password":"change-me"}]
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here

# Pyx (same base URL as public/pyx-client.js; optional key if your Pyx API requires it)
PYX_SERVICE_URL=https://pyxaiapi-574247481583.us-central1.run.app
# PYX_API_KEY=your-pyx-api-key-if-required

# Claude: game generation + Pyx moderation backup (optional)
# Add your key here, then:  npm run build  &&  firebase deploy --only functions
ANTHROPIC_API_KEY=

# Optional: other features that call OpenAI from the server (HistoriMac Computer Use is BYOK in the app).
OPENAI_API_KEY=
