{
  "hosting": [
    {
      "target": "main",
      "predeploy": ["npm run build"],
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "404": "404.html",
      "redirects": [
        {"source": "/home", "destination": "/", "type": 301},
        {"source": "/home/**", "destination": "/", "type": 301},
        {"source": "/play", "destination": "/", "type": 301},
        {"source": "/play/**", "destination": "/", "type": 301},
        {"source": "/index.html", "destination": "/", "type": 301},
        {"source": "/about/", "destination": "/about", "type": 301},
        {"source": "/historimac/", "destination": "/historimac", "type": 301},
        {"source": "/historimac/:version/", "destination": "/historimac/:version", "type": 301},
        {"source": "/safety", "destination": "/report", "type": 301},
        {"source": "/safety/**", "destination": "/report", "type": 301}
      ],
      "rewrites": [
        {"source": "/api/**", "function": "api"},
        {"source": "/", "destination": "/index.html"},
        {"source": "/games", "destination": "/games.html"},
        {"source": "/games/**", "destination": "/games.html"},
        {"source": "/studio", "destination": "/studio.html"},
        {"source": "/studio/**", "destination": "/studio.html"},
        {"source": "/avatarshop", "destination": "/avatarshop.html"},
        {"source": "/avatarshop/**", "destination": "/avatarshop.html"},
        {"source": "/coins", "destination": "/coins.html"},
        {"source": "/coins/**", "destination": "/coins.html"},
        {"source": "/friends", "destination": "/friends.html"},
        {"source": "/friends/**", "destination": "/friends.html"},
        {"source": "/settings", "destination": "/settings.html"},
        {"source": "/settings/**", "destination": "/settings.html"},
        {"source": "/donation", "destination": "/donation.html"},
        {"source": "/donation/**", "destination": "/donation.html"},
        {"source": "/report", "destination": "/report.html"},
        {"source": "/report/**", "destination": "/report.html"},
        {"source": "/about", "destination": "/about.html"},
        {"source": "/historimac", "destination": "/historimac.html"},
        {"source": "/mainlinelogin", "destination": "/mainlinelogin.html"},
        {"source": "/mainlinelogin/**", "destination": "/mainlinelogin.html"},
        {"source": "/verify", "destination": "/verify.html"},
        {"source": "/verify/**", "destination": "/verify.html"},
        {"source": "/signoutall", "destination": "/signoutall.html"},
        {"source": "/signoutall/**", "destination": "/signoutall.html"},
        {"source": "/user/**", "destination": "/index.html"},
        {"source": "/game/**", "destination": "/index.html"}
      ],
      "headers": [
        {"source": "sitemap*.xml", "headers": [{"key": "Content-Type", "value": "application/xml"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]},
        {"source": "robots.txt", "headers": [{"key": "Content-Type", "value": "text/plain"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]}
      ]
    },
    {
      "target": "pay",
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "404": "404.html",
      "rewrites": [
        {"source": "/api/**", "function": "api"},
        {"source": "**", "destination": "/index.html"}
      ],
      "headers": [
        {"source": "sitemap.xml", "headers": [{"key": "Content-Type", "value": "application/xml"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]},
        {"source": "robots.txt", "headers": [{"key": "Content-Type", "value": "text/plain"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]}
      ]
    },
    {
      "target": "status",
      "public": "status-site",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/README.md"],
      "headers": [
        {
          "source": "**/*.json",
          "headers": [{"key": "Content-Type", "value": "application/json"}, {"key": "Cache-Control", "value": "public, max-age=60"}]
        },
        {
          "source": "**",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=120"}]
        }
      ]
    }
  ],
  "functions": {"source": "functions", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]}
}
