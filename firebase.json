{
  "hosting": [
    {
      "target": "main",
      "predeploy": ["npm run build:hosting"],
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {"source": "/home", "destination": "/games", "type": 301},
        {"source": "/home/**", "destination": "/games", "type": 301},
        {"source": "/play", "destination": "/games", "type": 301},
        {"source": "/play/**", "destination": "/games", "type": 301}
      ],
      "rewrites": [
        {"source": "/api/**", "function": "api"},
        {"source": "/", "destination": "/index.html"},
        {"source": "/games", "destination": "/index.html"},
        {"source": "/games/**", "destination": "/index.html"},
        {"source": "/mainlinelogin", "destination": "/mainlinelogin.html"},
        {"source": "/mainlinelogin/**", "destination": "/mainlinelogin.html"},
        {"source": "/avatarshop", "destination": "/index.html"},
        {"source": "/avatarshop/**", "destination": "/index.html"},
        {"source": "/coins", "destination": "/index.html"},
        {"source": "/friends", "destination": "/index.html"},
        {"source": "/settings", "destination": "/index.html"},
        {"source": "/studio", "destination": "/index.html"},
        {"source": "/studio/**", "destination": "/index.html"},
        {"source": "/donation", "destination": "/index.html"},
        {"source": "**", "destination": "/index.html"}
      ],
      "headers": [
        {"source": "sitemap.xml", "headers": [{"key": "Content-Type", "value": "application/xml"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]},
        {"source": "robots.txt", "headers": [{"key": "Content-Type", "value": "text/plain"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]}
      ]
    },
    {
      "target": "pay",
      "predeploy": ["npm run build:hosting"],
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {"source": "/api/**", "function": "api"},
        {"source": "**", "destination": "/index.html"}
      ],
      "headers": [
        {"source": "sitemap.xml", "headers": [{"key": "Content-Type", "value": "application/xml"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]},
        {"source": "robots.txt", "headers": [{"key": "Content-Type", "value": "text/plain"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]}
      ]
    },
    {
      "target": "status",
      "public": "status-site",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/README.md"],
      "headers": [
        {
          "source": "**/*.json",
          "headers": [{"key": "Content-Type", "value": "application/json"}, {"key": "Cache-Control", "value": "public, max-age=60"}]
        },
        {
          "source": "**",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=120"}]
        }
      ]
    }
  ],
  "functions": {"source": "functions", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]}
}
