# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Data folder (contains user accounts, bans, reports, appeals, database)
/data/*.json
/data/*.db
/data/*.db-shm
/data/*.db-wal
!/data/.gitkeep
!/data/README.md

# VS Code extensions and user data
.vscode/extensions/
AppData/

# Unity project files (too large for GitHub)
/Gym_Pump/

# Firebase local
.firebase/

# Firebase Functions build output and deps
/functions/lib/
/functions/node_modules/

# Firebase Functions env (contains API keys - GitHub blocks pushes with secrets)
/functions/.env
/functions/.env.*
!/functions/.env.example

# Firebase service account key (never commit)
scripts/serviceAccountKey.json

# Tor hidden service private keys (hostname is public; keys are not)
onion/hidden_service/
onion/keys/
hs_ed25519_secret_key
hs_ed25519_public_key
hs_ed25519_secret_key_encrypted

# Eco Hero game (contains Anthropic API key for in-game AI citizens)
public/games/eco-hero.html












